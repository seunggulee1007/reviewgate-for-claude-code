{
  "about": "§44.2 the status line's ANSI text: both clients must turn these lines into these runs — the Mac (Core/Sources/ReviewGateCore/StatusLine/AnsiText.swift, Core/Tests/ReviewGateCoreTests/AnsiTextTests.swift) and Electron (clients/desktop/src/renderer/ansi.ts, ansi.test.ts). A run is {text, fg?, bg?, bold?, dim?, italic?, underline?, strike?, inverse?, hidden?, link?}: fg / bg a palette index 0–255 or \"#rrggbb\", a flag only when true, link an OSC 8 URI. Styles carry over from line to line (the CLI prefixes every line with the escapes of the lines above). SGR 0 does not end a link. Tabs go to the next multiple of 8 columns; other escapes (CSI that is not SGR, OSC other than 8, DCS/SOS/PM/APC, two-byte ESC sequences) and C0/C1 controls are dropped, an unterminated one with the rest of its line. width: display columns per grapheme (East Asian wide / fullwidth and emoji presentation 2, zero-width marks 0, else 1). truncate: lines wider than `columns` keep what fits in columns − 1 and end with an unstyled \"…\" (Ink's truncate). palette: the 16 basic colors per appearance (VS Code's terminal colors); xterm256: the cube (0, 95, 135, 175, 215, 255) and the 24 grays.",
  "palette": {
    "dark": ["#000000", "#cd3131", "#0dbc79", "#e5e510", "#2472c8", "#bc3fbc", "#11a8cd", "#e5e5e5", "#666666", "#f14c4c", "#23d18b", "#f5f543", "#3b8eea", "#d670d6", "#29b8db", "#ffffff"],
    "light": ["#000000", "#cd3131", "#00bc00", "#949800", "#0451a5", "#bc05bc", "#0598bc", "#555555", "#666666", "#cd3131", "#14ce14", "#b5ba00", "#0451a5", "#bc05bc", "#0598bc", "#a5a5a5"]
  },
  "xterm256": [
    [16, "#000000"],
    [21, "#0000ff"],
    [67, "#5f87af"],
    [196, "#ff0000"],
    [214, "#ffaf00"],
    [231, "#ffffff"],
    [232, "#080808"],
    [244, "#808080"],
    [255, "#eeeeee"]
  ],
  "parse": [
    { "name": "plain", "lines": ["hello"], "runs": [[{ "text": "hello" }]] },
    { "name": "empty line", "lines": [""], "runs": [[]] },
    { "name": "bold, then reset", "lines": ["\u001b[1mA\u001b[0mB"], "runs": [[{ "text": "A", "bold": true }, { "text": "B" }]] },
    { "name": "an empty SGR resets", "lines": ["\u001b[1mA\u001b[mB"], "runs": [[{ "text": "A", "bold": true }, { "text": "B" }]] },
    { "name": "16 colors, bright, default", "lines": ["\u001b[31mR\u001b[92mG\u001b[39mD"], "runs": [[{ "text": "R", "fg": 1 }, { "text": "G", "fg": 10 }, { "text": "D" }]] },
    { "name": "background and bright background", "lines": ["\u001b[44;97m X \u001b[49m!\u001b[103mY"], "runs": [[{ "text": " X ", "fg": 15, "bg": 4 }, { "text": "!", "fg": 15 }, { "text": "Y", "fg": 15, "bg": 11 }]] },
    { "name": "256 colors", "lines": ["\u001b[38;5;214mO\u001b[48;5;236mB"], "runs": [[{ "text": "O", "fg": 214 }, { "text": "B", "fg": 214, "bg": 236 }]] },
    { "name": "truecolor", "lines": ["\u001b[38;2;255;100;0mT\u001b[48;2;16;32;48mU"], "runs": [[{ "text": "T", "fg": "#ff6400" }, { "text": "U", "fg": "#ff6400", "bg": "#102030" }]] },
    { "name": "colon forms", "lines": ["\u001b[38:2::1:2:3mC\u001b[38:5:9mD\u001b[48:2:4:5:6mE"], "runs": [[{ "text": "C", "fg": "#010203" }, { "text": "D", "fg": 9 }, { "text": "E", "fg": 9, "bg": "#040506" }]] },
    { "name": "attributes and their offs", "lines": ["\u001b[2;3;4;9;7;8mS\u001b[23;24;29;27;28mN\u001b[22mP"], "runs": [[{ "text": "S", "dim": true, "italic": true, "underline": true, "strike": true, "inverse": true, "hidden": true }, { "text": "N", "dim": true }, { "text": "P" }]] },
    { "name": "22 ends bold and dim", "lines": ["\u001b[1;2mX\u001b[22mY"], "runs": [[{ "text": "X", "bold": true, "dim": true }, { "text": "Y" }]] },
    { "name": "codes it does not draw are ignored", "lines": ["\u001b[5;6;53;31mB\u001b[21mU\u001b[4:0mV\u001b[4:3mW"], "runs": [[{ "text": "B", "fg": 1 }, { "text": "U", "fg": 1, "underline": true }, { "text": "V", "fg": 1 }, { "text": "W", "fg": 1, "underline": true }]] },
    { "name": "an extended color without its numbers is ignored", "lines": ["\u001b[38;5mX\u001b[38;2;1;2mY\u001b[38;5;300mZ"], "runs": [[{ "text": "XYZ" }]] },
    { "name": "reset in one SGR, then more", "lines": ["\u001b[31;1mA\u001b[0;32mB"], "runs": [[{ "text": "A", "fg": 1, "bold": true }, { "text": "B", "fg": 2 }]] },
    { "name": "OSC 8 link ended by ST", "lines": ["see \u001b]8;;https://github.com/o/r/pull/1\u001b\\PR #1\u001b]8;;\u001b\\ ok"], "runs": [[{ "text": "see " }, { "text": "PR #1", "link": "https://github.com/o/r/pull/1" }, { "text": " ok" }]] },
    { "name": "OSC 8 with parameters, ended by BEL, styled inside", "lines": ["\u001b]8;id=x;https://e.com/a?b=1\u0007\u001b[4mL\u001b[24mM\u001b]8;;\u0007"], "runs": [[{ "text": "L", "underline": true, "link": "https://e.com/a?b=1" }, { "text": "M", "link": "https://e.com/a?b=1" }]] },
    { "name": "OSC 8 is read by code points (a mark right after a ';' is no part of it)", "lines": ["\u001b]8;́;https://x.y\u001b\\L\u001b]8;;\u001b\\"], "runs": [[{ "text": "L", "link": "https://x.y" }]] },
    { "name": "SGR 0 keeps the link", "lines": ["\u001b]8;;https://a.b\u001b\\\u001b[1mX\u001b[0mY\u001b]8;;\u001b\\Z"], "runs": [[{ "text": "X", "bold": true, "link": "https://a.b" }, { "text": "Y", "link": "https://a.b" }, { "text": "Z" }]] },
    { "name": "other escapes and controls are dropped", "lines": ["\u001b[2K\u001b[?25lA\u001b]0;title\u0007B\u001b(BC\u001b7D\u001bPdcs\u001b\\E\u0001F\u007fG\u0085H"], "runs": [[{ "text": "ABCDEFGH" }]] },
    { "name": "an unterminated CSI drops the rest", "lines": ["A\u001b[31"], "runs": [[{ "text": "A" }]] },
    { "name": "an unterminated OSC drops the rest", "lines": ["B\u001b]8;;https://x"], "runs": [[{ "text": "B" }]] },
    { "name": "a lone ESC at the end", "lines": ["C\u001b"], "runs": [[{ "text": "C" }]] },
    { "name": "a tab goes to the next multiple of 8 columns", "lines": ["a\tb", "사용\tc"], "runs": [[{ "text": "a       b" }], [{ "text": "사용    c" }]] },
    { "name": "styles carry over to the next line", "lines": ["\u001b[35mfirst", "second\u001b[0m third", "fourth"], "runs": [[{ "text": "first", "fg": 5 }], [{ "text": "second", "fg": 5 }, { "text": " third" }], [{ "text": "fourth" }]] },
    { "name": "a link carries over to the next line", "lines": ["\u001b]8;;https://a.b\u001b\\one", "two\u001b]8;;\u001b\\ x"], "runs": [[{ "text": "one", "link": "https://a.b" }], [{ "text": "two", "link": "https://a.b" }, { "text": " x" }]] },
    { "name": "emoji and Korean pass through", "lines": ["\u001b[32m👤 사용자\u001b[0m 📁 ~/dev"], "runs": [[{ "text": "👤 사용자", "fg": 2 }, { "text": " 📁 ~/dev" }]] },
    { "name": "the OMC HUD's first line", "lines": ["\u001b[2m[\u001b[0m\u001b[1m\u001b[36mOMC#5.7.15\u001b[0m\u001b[2m]\u001b[0m | Model: \u001b[35mOpus 5.5\u001b[0m"], "runs": [[{ "text": "[", "dim": true }, { "text": "OMC#5.7.15", "fg": 6, "bold": true }, { "text": "]", "dim": true }, { "text": " | Model: " }, { "text": "Opus 5.5", "fg": 5 }]] }
  ],
  "width": [
    ["abc", 3],
    ["", 0],
    ["사용자", 6],
    ["👤", 2],
    ["🔧6", 3],
    ["é", 1],
    ["👨‍👩‍👧", 2],
    ["🇰🇷", 2],
    ["█░─│", 4],
    ["❤️", 2],
    ["❤", 1],
    ["ｱ", 1],
    ["Ａ", 2],
    ["⚡", 2],
    ["✓", 1],
    ["…", 1],
    ["日本語", 6],
    ["Ğ", 1]
  ],
  "truncate": [
    { "name": "fits", "line": "abc", "columns": 3, "runs": [{ "text": "abc" }] },
    { "name": "cut with an unstyled ellipsis", "line": "\u001b[1mabcdef\u001b[0mgh", "columns": 5, "runs": [{ "text": "abcd", "bold": true }, { "text": "…" }] },
    { "name": "plain text and the ellipsis are one run", "line": "abcd", "columns": 3, "runs": [{ "text": "ab…" }] },
    { "name": "a wide character that does not fit is left out", "line": "사용자", "columns": 4, "runs": [{ "text": "사…" }] },
    { "name": "wide characters up to the edge", "line": "사용자abc", "columns": 5, "runs": [{ "text": "사용…" }] },
    { "name": "a link is cut too", "line": "\u001b]8;;https://a.b\u001b\\linktext\u001b]8;;\u001b\\", "columns": 5, "runs": [{ "text": "link", "link": "https://a.b" }, { "text": "…" }] },
    { "name": "one column left: only the ellipsis", "line": "\u001b[31mred\u001b[0m", "columns": 1, "runs": [{ "text": "…" }] },
    { "name": "no room", "line": "x", "columns": 0, "runs": [] }
  ]
}
