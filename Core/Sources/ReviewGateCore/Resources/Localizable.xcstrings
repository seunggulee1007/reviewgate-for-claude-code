      }
    },
    "Updates are read with the GitHub CLI (gh), which was not found. Install it (brew install gh), log in with gh auth login, then check again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are read with the GitHub CLI (gh), which was not found. Install it (brew install gh), log in with gh auth login, then check again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트는 GitHub CLI(gh)로 확인하는데 gh를 찾지 못했어요. 설치(brew install gh)하고 gh auth login으로 로그인한 뒤 다시 확인하세요."
          }
        }
      }
    },
    "The GitHub CLI (gh) is not logged in to github.com. Run gh auth login in Terminal, then check again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitHub CLI (gh) is not logged in to github.com. Run gh auth login in Terminal, then check again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI(gh)가 github.com에 로그인되어 있지 않아요. 터미널에서 gh auth login을 실행한 뒤 다시 확인하세요."
          }
        }
      }
    },
    "GitHub could not be reached. Check the network connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub could not be reached. Check the network connection and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 연결하지 못했어요. 네트워크 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "No release was found — none is published yet, or this GitHub account cannot see %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No release was found — none is published yet, or this GitHub account cannot see %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴리스를 찾지 못했어요 — 아직 게시된 릴리스가 없거나, 이 GitHub 계정으로는 %@ 저장소를 볼 수 없어요."
          }
        }
      }
    },
    "GitHub's reply could not be read (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub's reply could not be read (%@)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub의 응답을 읽지 못했어요(%@)."
          }
        }
      }
    },
    "The update check failed: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update check failed: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인에 실패했어요: %@"
          }
        }
      }
    },
    "At launch and every 6 hours ReviewGate asks GitHub for the latest release through the GitHub CLI (gh). Nothing is installed until you click Install and Restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At launch and every 6 hours ReviewGate asks GitHub for the latest release through the GitHub CLI (gh). Nothing is installed until you click Install and Restart."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 켤 때와 6시간마다 GitHub CLI(gh)로 GitHub에 최신 릴리스를 물어봐요. [설치하고 다시 시작]을 누르기 전에는 아무것도 설치하지 않아요."
          }
        }
      }
    },
    "Downloading ReviewGate %@…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading ReviewGate %@…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate %@ 다운로드하는 중…"
          }
        }
      }
    },
    "Checking the download's checksum…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the download's checksum…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 파일의 체크섬을 확인하는 중…"
          }
        }
      }
    },
    "Opening the disk image…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the disk image…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지를 여는 중…"
          }
        }
      }
    },
    "Checking the new app's signature and version…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the new app's signature and version…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 앱의 서명과 버전을 확인하는 중…"
          }
        }
      }
    },
    "ReviewGate %@ is ready. Claude is working in %lld windows — ReviewGate restarts when they finish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate %1$@ is ready. Claude is working in %2$lld windows — ReviewGate restarts when they finish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate %1$@ 설치 준비가 끝났어요. 창 %2$lld개에서 Claude가 작업 중이라, 작업이 끝나면 다시 시작해요."
          }
        }
      }
    },
    "ReviewGate %@ is ready. Claude is working — ReviewGate restarts when the turn finishes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate %@ is ready. Claude is working — ReviewGate restarts when the turn finishes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate %@ 설치 준비가 끝났어요. Claude가 작업 중이라, 턴이 끝나면 다시 시작해요."
          }
        }
      }
    },
    "Restarting into ReviewGate %@…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restarting into ReviewGate %@…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate %@(으)로 다시 시작하는 중…"
          }
        }
      }
    },
    "Could not install ReviewGate %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not install ReviewGate %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate %@을(를) 설치하지 못했어요"
          }
        }
      }
    },
    "The restart was cancelled, so nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restart was cancelled, so nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시작이 취소되어 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "The release has no ReviewGate DMG with its checksum to install.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The release has no ReviewGate DMG with its checksum to install."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스에는 설치할 ReviewGate DMG와 체크섬 파일이 없어요."
          }
        }
      }
    },
    "ReviewGate runs from a disk image or a temporary copy. Move it to the Applications folder first — the update replaces the app where it is.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate runs from a disk image or a temporary copy. Move it to the Applications folder first — the update replaces the app where it is."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate가 디스크 이미지나 임시 사본에서 실행 중이에요. 먼저 응용 프로그램 폴더로 옮기세요 — 업데이트는 지금 앱이 있는 자리의 앱을 바꿔요."
          }
        }
      }
    },
    "ReviewGate cannot write to %@. Install the update by hand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate cannot write to %@. Install the update by hand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ReviewGate가 %@에 쓸 수 없어요. 업데이트를 직접 설치하세요."
          }
        }
      }
    },
    "The download failed: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download failed: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드에 실패했어요: %@"
          }
        }
      }
    },
    "The release's checksum file is missing or unreadable — nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The release's checksum file is missing or unreadable — nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴리스의 체크섬 파일이 없거나 읽을 수 없어요 — 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "The download does not match its checksum — nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download does not match its checksum — nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 파일이 체크섬과 맞지 않아요 — 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "The disk image could not be opened: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk image could not be opened: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지를 열지 못했어요: %@"
          }
        }
      }
    },
    "The disk image has no ReviewGate app — nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk image has no ReviewGate app — nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지에 ReviewGate 앱이 없어요 — 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "The new app's signature is not valid (%@) — nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new app's signature is not valid (%@) — nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 앱의 서명이 유효하지 않아요(%@) — 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "This copy of ReviewGate has no team signature, so the new one cannot be checked against it. Install the update by hand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of ReviewGate has no team signature, so the new one cannot be checked against it. Install the update by hand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 ReviewGate에 팀 서명이 없어 새 앱과 비교할 수 없어요. 업데이트를 직접 설치하세요."
          }
        }
      }
    },
    "The new app is signed by another team (%@) than this one (%@) — nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new app is signed by another team (%1$@) than this one (%2$@) — nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 앱은 지금 앱(%2$@)과 다른 팀(%1$@)이 서명했어요 — 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "The new app says it is %@, not %@ — nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new app says it is %1$@, not %2$@ — nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 앱의 버전이 %2$@이(가) 아니라 %1$@이에요 — 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "The disk image holds another app (%@) than %@ — nothing was installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk image holds another app (%1$@) than %2$@ — nothing was installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지에 %2$@이(가) 아닌 다른 앱(%1$@)이 들어 있어요 — 아무것도 설치하지 않았어요."
          }
        }
      }
    },
    "The installer could not start: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installer could not start: %@"
          }
        },
        "ko": {
