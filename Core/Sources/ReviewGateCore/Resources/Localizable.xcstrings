    },
    "%@ cannot be committed this way — it is not an accepted file, or the part is gone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cannot be committed this way — it is not an accepted file, or the part is gone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이렇게 커밋할 수 없어요 — 수락한 파일이 아니거나 그 부분이 사라졌어요"
          }
        }
      }
    },
    "%@ changed (%@) — it may hold secrets, so its content is not kept and the change cannot be reverted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ changed (%2$@) — it may hold secrets, so its content is not kept and the change cannot be reverted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 이 바뀌었습니다 (%2$@) — 비밀값이 있을 수 있어 내용은 보관하지 않으며 되돌릴 수 없습니다."
          }
        }
      }
    },
    "%@ changed — it may hold secrets, so its content is not kept and the change cannot be reverted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ changed — it may hold secrets, so its content is not kept and the change cannot be reverted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이 바뀌었습니다 — 비밀값이 있을 수 있어 내용은 보관하지 않으며 되돌릴 수 없습니다."
          }
        }
      }
    },
    "%@ goes back to %@ as it was before this turn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ goes back to %@ as it was before this turn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 이번 턴 전 이름 %2$@(으)로 돌아가요."
          }
        }
      }
    },
    "%@ goes back to how it was before this turn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ goes back to how it was before this turn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이번 턴 전 상태로 돌아가요."
          }
        }
      }
    },
    "%@ is in two commits — a part can only be in one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is in two commits — a part can only be in one"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 두 커밋에 들어 있어요 — 한 부분은 한 커밋에만 넣을 수 있어요"
          }
        }
      }
    },
