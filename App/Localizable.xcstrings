        }
      }
    },
    "Claude writes the message in this format. {issue} = the issue number in the branch name (feature/acme/4821-17 → 4821), {branch} = the branch; Claude fills {title} and {summary}. Empty: Claude follows the format of the recent commits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude writes the message in this format. {issue} = the issue number in the branch name (feature/acme/4821-17 → 4821), {branch} = the branch; Claude fills {title} and {summary}. Empty: Claude follows the format of the recent commits."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 가 이 형식으로 메시지를 써요. {issue} = 브랜치 이름의 이슈 번호(feature/acme/4821-17 → 4821), {branch} = 브랜치, {title}·{summary} 는 Claude 가 채워요. 비워 두면 최근 커밋의 형식을 따라요."
          }
        }
      }
    },
