            "state": "translated",
            "value": "정상"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐"
          }
        }
      }
    },
    "Off: each line stays on one line and all lines of a diff scroll sideways together (trackpad, or Shift + scroll wheel).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: each line stays on one line and all lines of a diff scroll sideways together (trackpad, or Shift + scroll wheel)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 줄마다 한 줄로 두고, diff의 모든 줄이 함께 옆으로 스크롤돼요(트랙패드, 또는 Shift + 스크롤 휠)."
          }
        }
      }
    },
    "Off: every shell command asks for permission in the chat. Edits are always auto-allowed (the budget still applies). Takes effect on the next Open Project.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: every shell command asks for permission in the chat. Edits are always auto-allowed (the budget still applies). Takes effect on the next Open Project."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 모든 셸 명령이 채팅에서 권한을 요청합니다. 편집은 항상 자동 허용됩니다 (예산은 계속 적용). 다음에 프로젝트를 열 때 적용됩니다."
          }
        }
      }
    },
    "Off: hooks in ~/.claude and project settings and plugin hooks do not run — your statusLine is turned off too. ReviewGate's own safety hooks always stay on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: hooks in ~/.claude and project settings and plugin hooks do not run — your statusLine is turned off too. ReviewGate's own safety hooks always stay on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 ~/.claude·프로젝트 설정의 훅과 플러그인 훅이 실행되지 않습니다 — statusLine도 함께 꺼집니다. ReviewGate의 안전 훅은 항상 켜져 있습니다."
          }
        }
      }
    },
    "Off: reads, searches and read-only commands in a row fold into one line in the chat (click it to open).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: reads, searches and read-only commands in a row fold into one line in the chat (click it to open)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 연속된 읽기·검색·조회 명령을 채팅에서 한 줄로 접어요(누르면 펼쳐져요)."
          }
        }
      }
    },
    "Off: sent as a question while the files stay under review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: sent as a question while the files stay under review"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면: 파일은 리뷰 대기로 둔 채 질문으로 보냅니다"
          }
        }
      }
    },
    "On %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기준"
          }
        }
      }
    },
    "On launch, reopens the project windows that were open at last quit (up to %lld). Off: the app starts with the empty state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On launch, reopens the project windows that were open at last quit (up to %lld). Off: the app starts with the empty state."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 시작할 때 마지막 종료 시점에 열려 있던 프로젝트 창을 최대 %lld개까지 다시 엽니다. 끄면 빈 화면으로 시작합니다."
          }
        }
      }
    },
    "On the first / last line of the message box": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the first / last line of the message box"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 입력란의 첫 줄·마지막 줄에서"
          }
        }
      }
    },
    "One pattern per line (mvnw, .mvn/**, config/local/*.yml). Only untracked or ignored files of this worktree are copied — never a tracked file or .git.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One pattern per line (mvnw, .mvn/**, config/local/*.yml). Only untracked or ignored files of this worktree are copied — never a tracked file or .git."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 패턴 하나(mvnw, .mvn/**, config/local/*.yml). 이 worktree에서 추적하지 않거나 무시된 파일만 복사합니다 — 추적 중인 파일과 .git은 복사하지 않습니다."
          }
        }
      }
    },
    "One per line, matched against each command of a Bash call as typed — * is any run of characters, ? one character. A matching command counts as a test run in the turn summary. Applied when you leave this box.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per line, matched against each command of a Bash call as typed — * is any run of characters, ? one character. A matching command counts as a test run in the turn summary. Applied when you leave this box."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나씩 — Bash 호출의 명령 하나하나에 입력된 그대로 맞춰 봅니다. *는 아무 문자열, ?는 한 글자입니다. 맞는 명령은 턴 요약에서 테스트 실행으로 셉니다. 이 칸을 벗어나면 적용됩니다."
          }
        }
      }
    },
    "One per line; a path prefix (e.g. .omc/) or a glob with * (e.g. *.log). Matching files are hidden from the review list and never reverted. Applied to every open project when you leave this box, from the next collected turn or refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per line; a path prefix (e.g. .omc/) or a glob with * (e.g. *.log). Matching files are hidden from the review list and never reverted. Applied to every open project when you leave this box, from the next collected turn or refresh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나씩. 경로 접두사(예: .omc/) 또는 *를 쓰는 glob(예: *.log). 일치하는 파일은 리뷰 목록에서 숨겨지며 되돌려지지 않습니다. 이 칸을 벗어나면 열린 모든 프로젝트에 적용되고, 다음에 수집되는 턴이나 새로고침부터 반영됩니다."
          }
        }
      }
    },
    "One per line; a path prefix (e.g. .omc/) or a glob with * (e.g. *.log). Matching files are hidden from the review list and never reverted. Applies to the next turn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per line; a path prefix (e.g. .omc/) or a glob with * (e.g. *.log). Matching files are hidden from the review list and never reverted. Applies to the next turn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나씩. 경로 접두사(예: .omc/) 또는 *를 쓰는 glob(예: *.log). 일치하는 파일은 리뷰 목록에서 숨겨지며 되돌려지지 않습니다. 다음 턴부터 적용됩니다."
          }
        }
      }
    },
    "Only Markdown files that exist can be opened": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Markdown files that exist can be opened"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "있는 Markdown 파일만 열 수 있어요"
          }
        }
      }
    },
    "Only files Claude changed are restored — your own work elsewhere is never touched. The old chat is kept as “(되돌리기 전)”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only files Claude changed are restored — your own work elsewhere is never touched. The old chat is kept as “(되돌리기 전)”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 바꾼 파일만 되돌립니다 — 다른 곳의 직접 작업은 건드리지 않습니다. 기존 채팅은 “(되돌리기 전)”으로 남습니다."
          }
        }
      }
    },
    "Only files inside this repository can be mentioned: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only files inside this repository can be mentioned: %@"
