      }
    },
    "The full output is no longer kept (engine restarted or evicted) — showing the preview.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full output is no longer kept (engine restarted or evicted) — showing the preview."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 출력이 더 이상 보관되어 있지 않습니다(엔진 재시작 또는 만료) — 미리보기를 표시합니다."
          }
        }
      }
    },
    "The index Claude reads at the start of every chat. Each line points to one memory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The index Claude reads at the start of every chat. Each line points to one memory."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 가 대화를 시작할 때마다 읽는 색인이에요. 한 줄이 메모리 하나를 가리켜요."
          }
        }
      }
    },
    "The installed app (%@) is newer than this one (%@). Replace it anyway? The installed app goes to the Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed app (%@) is newer than this one (%@). Replace it anyway? The installed app goes to the Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱(%1$@)이 지금 앱(%2$@)보다 새 버전이에요. 그래도 바꿀까요? 설치된 앱은 휴지통으로 가요."
          }
        }
      }
    },
    "The installed app is the same version (%@). Replace it, or open the installed one? The installed app goes to the Trash when replaced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed app is the same version (%@). Replace it, or open the installed one? The installed app goes to the Trash when replaced."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱도 같은 버전(%@)이에요. 바꿀까요, 아니면 설치된 앱을 열까요? 바꾸면 설치된 앱은 휴지통으로 가요."
          }
        }
      }
    },
    "The last run failed: %@": {
