    },
    "Claude keeps what it learns in your chats here — your preferences, feedback, facts about the project. Once it does, they show up as a graph.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude keeps what it learns in your chats here — your preferences, feedback, facts about the project. Once it does, they show up as a graph."
          }
