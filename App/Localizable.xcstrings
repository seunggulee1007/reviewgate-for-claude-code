          }
        }
      }
    },
    "You can ask questions without accepting: sending never accepts or rejects a file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ask questions without accepting: sending never accepts or rejects a file."
