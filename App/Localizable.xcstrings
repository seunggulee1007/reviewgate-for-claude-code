        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지 직전부터 새 채팅으로 이어갑니다. 기존 채팅은 “(되돌리기 전)”으로 남습니다."
          }
        }
      }
    },
    "A note goes back with “Keep planning” as “Step N (…): …”. Steps without a note are left as they are.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note goes back with “Keep planning” as “Step N (…): …”. Steps without a note are left as they are."
