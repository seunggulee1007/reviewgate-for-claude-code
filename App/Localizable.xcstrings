    },
    "Claude Code status line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code status line"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 상태줄"
          }
        }
      }
    },
    "Claude Code updates itself in the background. Pin a version to keep starting new sessions with it; ReviewGate marks the versions it was checked with.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code updates itself in the background. Pin a version to keep starting new sessions with it; ReviewGate marks the versions it was checked with."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code는 백그라운드에서 스스로 업데이트돼요. 버전을 고정하면 새 세션을 계속 그 버전으로 시작해요. ReviewGate가 확인한 버전에는 '검증됨'이 붙어요."
          }
        }
      }
    },
    "Claude Code's estimate from the tokens each model used — not a bill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code's estimate from the tokens each model used — not a bill"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델별 토큰으로 Claude Code가 낸 추정치예요 — 실제 청구액과 다를 수 있어요"
          }
        }
      }
    },
    "Claude can hand work to these; a file's change applies from the next session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude can hand work to these; a file's change applies from the next session."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 가 일을 맡길 수 있는 서브에이전트예요. 파일을 고치면 다음 세션부터 적용돼요."
          }
        }
      }
    },
    "Claude did what this note asked — remove it": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude did what this note asked — remove it"
          }
