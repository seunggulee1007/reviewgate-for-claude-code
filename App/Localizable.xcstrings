          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 ↩로 보내고 ⇧↩로 줄을 바꿔요. 끄면 ↩로 줄을 바꾸고 ⌘↩로 보내요. ⌘↩는 어느 쪽이든 보내요."
          }
        }
