    "%@\n\nForce removal discards uncommitted changes and ignores another session's lock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nForce removal discards uncommitted changes and ignores another session's lock."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n강제 제거는 커밋되지 않은 변경사항을 버리고 다른 세션의 잠금을 무시합니다."
          }
        }
      }
    },
    "%@ (%lld)": {
      "shouldTranslate": false
    },
    "%@ (from %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (from %@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (이전: %2$@)"
          }
        }
      }
    },
    "%@ / %@ tokens — compacting summarizes the conversation so far and frees up space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ tokens — compacting summarizes the conversation so far and frees up space."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ 토큰 — 압축하면 지금까지의 대화를 요약해 공간을 확보합니다."
          }
        }
      }
    },
    "%@ is not on the remote yet — Create PR pushes it first, then runs `gh pr create` against %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not on the remote yet — Create PR pushes it first, then runs `gh pr create` against %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 는 아직 원격에 없어요 — PR 만들기를 누르면 먼저 푸시하고 %2$@ 대상으로 `gh pr create` 를 실행해요."
          }
        }
      }
    },
