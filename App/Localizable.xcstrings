            "state": "translated",
            "value": "The file on disk no longer matches this diff — refresh to see more lines"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크의 파일이 이 diff와 달라졌어요 — 새로고침하면 줄을 더 볼 수 있어요"
          }
        }
      }
    },
    "The file's lines do not match this diff — more lines cannot be shown": {
