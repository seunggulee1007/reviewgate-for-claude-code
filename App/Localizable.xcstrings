          }
        }
      }
    },
    "A link asked ReviewGate to open %@. Claude Code starts there with that folder's own project settings and hooks — open it only if you trust it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link asked ReviewGate to open %@. Claude Code starts there with that folder's own project settings and hooks — open it only if you trust it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 ReviewGate에 %@ 폴더를 열어 달라고 했어요. Claude Code가 그 폴더의 프로젝트 설정과 훅으로 시작하니, 믿을 수 있는 폴더일 때만 여세요."
          }
        }
      }
    },
    "A new chat continues from before this message; the files stay as they are.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new chat continues from before this message; the files stay as they are."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지 직전부터 새 채팅으로 이어갑니다. 파일은 그대로 둡니다."
          }
        }
      }
    },
    "A new chat continues from before this message; the old one is kept as “(되돌리기 전)”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new chat continues from before this message; the old one is kept as “(되돌리기 전)”."
