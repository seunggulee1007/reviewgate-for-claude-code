{
  "name": "@reviewgate/desktop",
  "version": "0.5.13",
  "private": true,
  "author": "leeseunggu",
  "description": "ReviewGate desktop client (Electron) — Windows first, runs on macOS for development",
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "e2e": "node scripts/build.mjs && electron . --e2e",
    "dist:win": "node scripts/build.mjs && electron-builder --win nsis --x64",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac dir",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "diff": "^8.0.2",
    "dompurify": "3.4.15",
    "marked": "18.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.0"
  }
}
